{
  "name": "skilltrack-backend",
  "version": "1.0.0",
  "description": "SkillTrack AI Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node src/seed.ts",
    "seed:admin": "npx ts-node src/scripts/seedAdmin.ts",
    "seed:colleges": "npx ts-node src/scripts/seedColleges.ts",
    "seed:career-roles": "npx ts-node src/scripts/seedCareerRoles.ts",
    "seed:assessments": "npx ts-node src/scripts/seedAssessments.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^9.10.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "nodemailer": "^9.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.7",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
